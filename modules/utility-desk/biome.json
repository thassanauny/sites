{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "tests/**", "*.ts", "*.js", "biome.json", "package.json", "tsconfig.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 320 },
  "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off", "noConfusingVoidType": "off", "noControlCharactersInRegex": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
