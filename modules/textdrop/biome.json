{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false },
  "files": { "includes": ["*.ts", "src/**/*.ts", "tests/**/*.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 200 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "style": { "noNonNullAssertion": "off" } } },
  "assist": { "enabled": false }
}
